# Entorno de ejecución: development | test | production
NODE_ENV=development
PORT=3000

# Conexión a PostgreSQL (ver docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/apipixelmango

# Secretos JWT: distintos entre sí y de al menos 32 caracteres.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambia-este-secreto-de-access-token-por-uno-aleatorio
JWT_REFRESH_SECRET=cambia-este-secreto-de-refresh-token-por-otro-aleatorio

# Orígenes permitidos por CORS, separados por comas
CORS_ORIGINS=http://localhost:3001

# Páginas del frontend que reciben el token como ?token=...
FRONTEND_CONFIRM_EMAIL_URL=http://localhost:3001/confirmar-cuenta
FRONTEND_RESET_PASSWORD_URL=http://localhost:3001/restablecer-contrasena

# SMTP de Brevo (Configuración > SMTP y API > SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=usuario-smtp@smtp-brevo.com
SMTP_PASS=clave-smtp-de-ejemplo
SMTP_EMAIL_FROM="Pixel Mango <no-reply@example.com>"
